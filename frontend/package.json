{
  "name": "jt-ipam-frontend",
  "version": "0.3.0",
  "description": "jt-ipam — 新世代 IPAM 系統前端",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 5173 --host",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css,scss,json,md}\"",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "pinia": "^2.2.6",
    "naive-ui": "^2.40.1",
    "vfonts": "^0.0.3",
    "vue-i18n": "^10.0.4",
    "@vueuse/core": "^11.2.0",
    "axios": "^1.7.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
