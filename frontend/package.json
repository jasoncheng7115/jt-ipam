{
  "name": "jt-ipam-frontend",
  "version": "1.0.18",
  "description": "jt-ipam — 可自架的整合型 IPAM 系統前端",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 5173 --host",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css,scss,json,md}\"",
    "audit": "pnpm audit --audit-level=moderate",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/orbitron": "5.3.0",
    "@fontsource/audiowide": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@iconoir/vue": "^7.11.0",
    "@novnc/novnc": "^1.7.0",
    "@vueuse/core": "^11.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.20.0",
    "cytoscape": "^3.30.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "fzstd": "0.1.1",
    "naive-ui": "^2.40.1",
    "pinia": "^2.2.6",
    "qrcode": "^1.5.4",
    "tweetnacl": "1.0.3",
    "vfonts": "^0.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/cytoscape": "^3.21.7",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "form-data@<4.0.6": ">=4.0.6",
      "vite@<6.4.5": ">=6.4.5 <7",
      "follow-redirects@<1.16.2": ">=1.16.2",
      "js-yaml@<5.4.1": ">=5.4.1 <6",
      "postcss@<8.5.18": ">=8.5.18",
      "brace-expansion@1": ">=1.1.21 <2",
      "brace-expansion@2": ">=2.1.7 <3",
      "brace-expansion@5": ">=5.0.12",
      "nanoid@3": ">=3.3.17 <4",
      "source-map-js@<1.2.2": ">=1.2.2",
      "glob@>=9 <14.0.2": ">=14.0.2",
      "minimatch@10": ">=11.0.1",
      "minimatch@9": ">=11.0.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-g3hv-75wg-m249"
      ]
    }
  }
}
